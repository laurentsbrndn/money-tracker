// Copy to Secrets.xcconfig (not committed) and fill in the values.
// "//" starts a comment in xcconfig, so URLs are written as http:/$()/host.

// Origin only, without /v1 (paths in openapi.yaml already start with /v1).
API_BASE_URL = http:/$()/localhost:8080

// Placeholders: fill in from RevenueCat and Google Cloud (Phase 1 and 3).
REVENUECAT_IOS_KEY =
GOOGLE_IOS_CLIENT_ID =
