# Salin ke .env untuk pengembangan lokal. Jangan commit .env.
# Nilai di bawah hanya placeholder.

# --- Inti (wajib, divalidasi saat start) ---
APP_ENV=local
PORT=8080
# Neon pooled (hostname memuat -pooler)
DATABASE_URL=postgres://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&connect_timeout=10
# minimal 32 byte acak
JWT_SECRET=
JWT_ISSUER=moneytracker-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=1440h
# minimal 32 byte acak
OTP_SECRET=
# minimal 16 karakter acak, sama dengan env Vercel
CRON_SECRET=
MIN_APP_VERSION_ANDROID=0.0.0
MIN_APP_VERSION_IOS=0.0.0
LOG_LEVEL=info

# --- Migrate saja (Neon direct, tanpa -pooler) ---
DATABASE_URL_DIRECT=postgres://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# --- Integrasi (divalidasi saat modul terkait dihubungkan: Fase 1 dan 3) ---
APPLE_BUNDLE_ID=
# daftar dipisah koma
GOOGLE_CLIENT_IDS=
# kosong di lokal -> kode ditulis ke log
RESEND_API_KEY=
EMAIL_FROM=Money Tracker <no-reply@example.com>
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_SECRET_API_KEY=
# opsional; default https://api.revenuecat.com (hanya untuk RevenueCat palsu saat verifikasi lokal)
REVENUECAT_API_BASE_URL=
